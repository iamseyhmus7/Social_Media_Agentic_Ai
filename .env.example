DATABASE_URL=sqlite:///./data/sahne.db
MEDIA_ROOT=./data/media
QUEUE_MODE=local
BROKER_URL=redis://localhost:6379/0
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Generate with: python -m backend.app.cli generate-key
TOKEN_ENCRYPTION_KEY=
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=deepseek-v4.1-flash
EVREN_MEDIA_MODEL=mimo-v2.6-pro
# Only sampled-frame visual inspection; editing and other media roles stay above.
EVREN_MEDIA_MODEL2=qwen3-vl-30b
# structured_actions works over the existing JSON contract. Enable native_tools only after gateway acceptance.
AGENT_PROTOCOL=structured_actions
VIDEO_EXECUTION_POLICY=planned_v1
SUPERVISOR_POLICY=model_v4
EVREN_SUPERVISOR_MODEL=mimo-v2.6-pro
SUPERVISOR_TIMEOUT_SECONDS=180
# Candidate remains disabled without a matching four-clip / >=20% certificate.
KAGGLE_MOTION_PROFILE=certified_auto
AGENT_MAX_TURNS=80
AGENT_TASK_MAX_TURNS=12
EVREN_RESPONSE_TIMEOUT_SECONDS=1800
# Model capability alone does not confirm Evren gateway compatibility.
EVREN_AUDIO_INPUT_VERIFIED=false
EVREN_VIDEO_INPUT_VERIFIED=false
# Only enable after verifying Evren's actual API contract.
EVREN_PROTOCOL=unconfigured
EVREN_CONTRACT_VERIFIED=false
EVREN_COMPLETIONS_PATH=/chat/completions
IMAGE_MODEL=segmind/SSD-1B
IMAGE_DEVICE=auto
# Remote image generation (local / cloudflare)
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_STEPS=4
# Turkish narration through ElevenLabs
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_SOURCE=api
ELEVENLABS_FREE_VOICES_ONLY=true
ELEVENLABS_PREVIEW_CHECKS=3
# Optional JSON array of {key,name,voice_id,description}; agent selects from this list.
ELEVENLABS_VOICE_PROFILES=[]
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/youtube/callback
YOUTUBE_API_KEY=
# Comma separated administrator-selected RSS URLs. No user-controlled fetch URLs.
RSS_FEEDS=
MAX_DISK_GB=20
SESSION_HOURS=24
# Automatic image-to-video jobs (none / kaggle); never add tokens to frontend.
VIDEO_PROVIDER=kaggle
EDITOR_PROVIDER=remotion
EDITOR_STREAMING_ENABLED=true
VIDEO_REVIEW_POLICY=technical_only
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_POLL_SECONDS=30
KAGGLE_TIMEOUT_SECONDS=7200
# Optional prepared private kernel output; blank prepares the pinned runtime once.
KAGGLE_RUNTIME_SOURCE=
REMOTION_ROOT=remotion
REMOTION_BROWSER_EXECUTABLE=
EDITOR_CALL_TIMEOUT_SECONDS=0
ELEVENLABS_TURKISH_ONLY=true
